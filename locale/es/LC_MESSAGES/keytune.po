msgid "A autenticação informada não contém cookies válidos do YouTube."
msgstr "La autenticación proporcionada no contiene cookies válidas de YouTube."

msgid "A autenticação salva do YouTube foi removida."
msgstr "La autenticación guardada de YouTube fue eliminada."

msgid "A autenticação salva do YouTube não é mais válida."
msgstr "La autenticación guardada de YouTube ya no es válida."

msgid "A avaliação solicitada para a mídia atual é inválida."
msgstr "La valoración solicitada para el medio actual no es válida."

msgid "A biblioteca inteligente está desligada. Ative em Preferências, aba Biblioteca."
